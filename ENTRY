;; -*- mode: Scheme;-*-

;; This an Artanis ENTRY file, don't remove it!

(add-to-load-path (string-append (current-toplevel) "/lib"))

(use-modules (artanis artanis)
             ;; Put modules you want to be imported here
             ;; only for this file, not controllers/views
             (ice-9 threads)
             (ice-9 i18n)
             (web request)
             (web uri)
             (rnrs io ports)
             (pingwing sqlite task)
             (pingwing domain task)
             (artanis utils))
;; Put whatever you want to be called before server initilization here

(init-server #:statics '(png gif
                             jpg
                             jpeg
                             ico
                             html
                             js
                             json
                             csv
                             xml
                             css
                             woff
                             woff2
                             ttf))

;; Put whatever you want to be called before server running here

;; Specify the directory where the MO file is located
(bindtextdomain "translate" "./sys/i18n/locale")
(bind-textdomain-codeset "translate" "UTF-8")
;; Specify the domain of the MO file since you may have multiple MO files
(textdomain "translate")
;; Set base locale for gettext at startup
(setlocale LC_MESSAGES "en_US.UTF-8")

(load "env.scm")

(define pingwing-settings
  `((mail (access-key unquote pingwing-mail-access-key)
          (access-secret unquote pingwing-mail-access-secret)
          (access-server unquote pingwing-mail-access-server)
          (access-port unquote pingwing-mail-access-port))
    (pingwing (worker-sleep-seconds . 5))))

;; Store the thread object belonging to the pingwing queue worker
(define worker-thread
  #f)

;; Procedure to start the pingwing queue worker to process jobs that haven't completed yet
;; this is preferrably done in a different thread
(define (start-worker)
  (use-modules (pingwing tasks)
               (pingwing sqlite task)
               (pingwing domain task))
  (let* ( ;use dummy route so as to hook into Artanis request context
          (mock-port (open-bytevector-input-port #vu8()))
         (mock-request (build-request (string->uri
                                       "http://localhost:50077/dummy-pipeline-context")
                                      #:method 'POST
                                      #:headers '()
                                      #:port mock-port))
         (mock-body (read-request-body mock-request))
         ;; fake request context will be used to get DB connection
         (rc (new-route-context mock-request mock-body))
         (task-repo (make-sqlite-task-repository rc))
         (t (call-with-new-thread (lambda ()
                                    (pingwing-worker-thread #:settings
                                                            pingwing-settings
                                                            #:task-repo
                                                            task-repo)))))
    (set! worker-thread t)))

;; define dummy route so that fake request-context can be used
(post "/dummy-pipeline-context"
      (lambda (rc)
        "dummy"))

;; Add hook on before running the Artanis application to start the queue worker
(run-before-run! start-worker)

;; Procedure to stop the pingwing queue worker
(define (cancel-worker)
  (display "\nterminating pingwing queue worker\n")
  (cancel-thread worker-thread))

;; Add a hook on SIGINT to stop the queue worker
(run-when-sigint! cancel-worker)

